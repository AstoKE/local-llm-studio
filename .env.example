STUDIO_OLLAMA_URL=http://127.0.0.1:11434
STUDIO_DATABASE_URL=sqlite:///./data/studio.db
# Optional API administrator token; never place secrets in NEXT_PUBLIC variables.
STUDIO_ADMIN_TOKEN=
STUDIO_WEB_ORIGIN=http://127.0.0.1:3000
# Background host monitoring; rows are additionally capped to bound local disk use.
STUDIO_METRICS_INTERVAL_SECONDS=5
STUDIO_METRICS_RETENTION_HOURS=24

# Generate using .venv/bin/python scripts/password_hash.py; paste the hash here.
STUDIO_ADMIN_PASSWORD_HASH=
STUDIO_SESSION_HOURS=8
# Optional HTTPS gateway mode. Keep false for localhost use.
STUDIO_LAN_MODE=false

# Upper bound before JSON parsing (default 2 MiB; range 64 KiB–16 MiB).
STUDIO_MAX_REQUEST_BYTES=2097152
